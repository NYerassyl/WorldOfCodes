{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "frontend",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    },
    "api": {
      "root": ".",
      "entrypoint": "server/vercel.js",
      "bindings": [
        {
          "type": "service",
          "service": "auth",
          "format": "url",
          "env": "FASTAPI_INTERNAL_URL"
        }
      ]
    },
    "auth": {
      "root": "services/fastapi-backend",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    { "source": "/api/auth/(.*)", "destination": { "service": "auth" } },
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ],
  "git": {
    "deploymentEnabled": {
      "integration/nov17-combined": false
    }
  }
}
