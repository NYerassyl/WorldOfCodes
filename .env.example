# Server only. Copy to .env and supply your own credentials.
DATABASE_URL=postgresql://worldofcodes:change_me@127.0.0.1:5432/worldofcodes?schema=public
PORT=4001
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4001,http://127.0.0.1:4001
# Only set when behind a known reverse proxy, never trust all proxies.
TRUST_PROXY_HOPS=0
AUTH_RATE_LIMIT=20
AUTH_WINDOW_MS=900000
SUBMISSION_RATE_LIMIT=30
SUBMISSION_WINDOW_MS=60000
REQUEST_BODY_LIMIT=32kb
JUDGE_IMAGE=python:3.12-alpine
JUDGE_CONCURRENCY=2
JUDGE_QUEUE_LIMIT=20
